@model SkillHub.Application.Dtos.Auth.RegisterRequestDto
@{
    ViewData["Title"] = "Crear Cuenta";
    Layout = "_Layout";
}

<div class="row justify-content-center align-items-center" style="min-height: 80vh;">
    <div class="col-md-5">
        <div class="card card-custom p-4 p-md-5">
            <div class="text-center mb-4">
                <div class="d-inline-flex bg-light rounded-circle p-3 mb-3">
                    <span class="material-symbols-outlined text-secondary-custom" style="font-size: 36px;">person_add</span>
                </div>
                <h2 class="fw-bold">Crea tu cuenta</h2>
                <p class="text-muted">Únete a SkillHub y comienza a aprender.</p>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @Html.ValidationSummary(false, "", new { @class = "mb-0" })
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <form asp-action="Register" method="post">
                <div class="mb-3">
                    <label asp-for="FullName" class="form-label fw-semibold">Nombre Completo</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white"><span class="material-symbols-outlined text-muted" style="font-size: 20px;">badge</span></span>
                        <input asp-for="FullName" class="form-control" placeholder="Ana García" required autofocus />
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-semibold">Correo Electrónico</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white"><span class="material-symbols-outlined text-muted" style="font-size: 20px;">mail</span></span>
                        <input asp-for="Email" class="form-control" placeholder="ejemplo@skillhub.com" required />
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="Password" class="form-label fw-semibold">Contraseña</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white"><span class="material-symbols-outlined text-muted" style="font-size: 20px;">lock</span></span>
                        <input asp-for="Password" type="password" class="form-control" placeholder="Mínimo 6 caracteres" required minlength="6" />
                    </div>
                </div>

                <button type="submit" class="btn bg-primary-custom w-100 py-3 fw-bold fs-5 rounded-3 mb-3">
                    Registrarme <span class="material-symbols-outlined align-middle ms-1" style="font-size: 20px;">arrow_forward</span>
                </button>
            </form>

            <div class="text-center mt-3">
                <p class="text-muted">¿Ya tienes cuenta? <a asp-action="Login" class="text-secondary-custom fw-bold text-decoration-none">Inicia sesión</a></p>
            </div>
        </div>
    </div>
</div>
